# Plantilla de variables de entorno - Anglo Electric
# Copiar este archivo como .env y completar con los valores reales.
# El archivo .env NUNCA debe subirse al repositorio.

# Cadena de conexión a PostgreSQL en Neon
DATABASE_URL=postgresql://usuario:password@host.neon.tech/neondb?sslmode=require

# Clave para firmar los tokens JWT (mínimo 32 caracteres aleatorios)
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Orígenes permitidos para CORS (frontend)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
